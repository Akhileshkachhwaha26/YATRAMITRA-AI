PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/yatramitra
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_secret

# Choose one external AI provider. Keys stay SERVER-SIDE and are never sent to React.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional payments (Razorpay test mode recommended for demos)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional monitoring
SENTRY_DSN=
